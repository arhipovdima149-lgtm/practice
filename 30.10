Задание 1
const siteA = ['anna', 'ivan', 'anna', 'petr', 'olga'];
const siteB = ['ivan', 'anna', 'sergey', 'olga', 'ivan'];

const setA = new Set(siteA);
console.log(setA);
console.log(setA.size);
console.log(setA.has('petr'));
const allVisitors = new Set([...siteA, ...siteB]);
console.log([...allVisitors]);

Задание 2

const phoneBook = new Map();
phoneBook
  .set('Ivanov', '+7-900-111-22-33')
  .set('Petrova', '+7-900-444-55-66')
  .set('Sidorov', '+7-900-777-88-99');

const petrovaPhone = phoneBook.get('Petrova');
console.log('Телефон Petrova:', petrovaPhone); 
phoneBook.delete('Sidorov');
console.log('Размер справочника:', phoneBook.size); 
const isSidorovPresent = phoneBook.has('Sidorov');
console.log('Есть ли Sidorov в справочнике:', isSidorovPresent); 
const employeesNames = [...phoneBook.keys()];
console.log('Имена сотрудников:', employeesNames); 
phoneBook.forEach((phone, name) => {
  console.log(`${name}: ${phone}`);
});


Задане 3
const students = [
  { name: 'Anna', grade: 5 },
  { name: 'Ivan', grade: 4 },
  { name: 'Anna', grade: 5 },
  { name: 'Petr', grade: 3 },
  { name: 'Olga', grade: 4 },
  { name: 'Ivan', grade: 4 }
];

const uniqueStudents = [...new Set(students.map(s => JSON.stringify(s)))]
  .map(s => JSON.parse(s));

const gradeMap = new Map();
students.forEach(s => {
  if (!gradeMap.has(s.grade)) gradeMap.set(s.grade, );
  gradeMap.get(s.grade).push(s.name);
});

for (const [grade, names] of gradeMap.entries()) {
  console.log(`Оценка ${grade}: ${names.join(', ')}`);
}
console.log([...gradeMap.keys()]);

Задание 4

function sumTo(n) {
  if (n <= 0) {
    return 0;
  }
  if (n === 1) {
    return 1;
  }
  return n + sumTo(n - 1);
}
console.log(sumTo(1)); 
console.log(sumTo(3)); 
console.log(sumTo(5)); 


Задание 5

function power(a, n) {
  if (n === 0) return 1;
  return a * power(a, n - 1);
}

console.log(power(2, 0)); // 1
console.log(power(2, 3)); // 8
console.log(power(3, 2)); // 9
console.log(power(5, 3)); // 125

Задание 6
const students = [
  { name: 'Anna', grade: 5 },
  { name: 'Ivan', grade: 4 },
  { name: 'Anna', grade: 5 },
  { name: 'Petr', grade: 3 },
  { name: 'Olga', grade: 4 },
  { name: 'Ivan', grade: 4 }
];

// Уникальные студенты
const uniqueStudents = [...new Set(students.map(s => JSON.stringify(s)))]
  .map(s => JSON.parse(s));

// Группировка по оценкам
const gradeMap = new Map();
students.forEach(s => {
  if (!gradeMap.has(s.grade)) gradeMap.set(s.grade, );
  gradeMap.get(s.grade).push(s.name);
});

// Вывод результатов
for (const [grade, names] of gradeMap.entries()) {
  console.log(`Оценка ${grade}: ${names.join(', ')}`);
}
console.log([...gradeMap.keys()]);
