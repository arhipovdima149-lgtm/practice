<!DOCTYPE html>
<html>
  <head>
    <title>Мой список дел</title>
    <style>
      body { font-family: Arial, sans-serif; text-align: center; }
      #app { display: inline-block; text-align: left; }
      input { padding: 8px; width: 200px; }
      button { padding: 8px 12px; }
      ul { list-style: none; padding: 0; }
      li { padding: 5px 0; display: flex; justify-content: space-between; align-items: center; }
      .count { margin-top: 10px; font-weight: bold; }
    </style>
  </head>
  <body>
    <div id="app">
      <h2>Мой список дел</h2>
      <input type="text" id="taskInput" placeholder="Новая задача">
      <button onclick="addTask()">Добавить</button>
      <ul id="taskList"></ul>
      <div class="count">Количество задач: <span id="taskCount">0</span></div>
    </div>

    <script>
      const input = document.getElementById('taskInput');
      const list = document.getElementById('taskList');
      const countSpan = document.getElementById('taskCount');
      let tasks = ;

      function render() {
        list.innerHTML = '';
        tasks.forEach((task, index) => {
          const li = document.createElement('li');
          li.textContent = task;
          const btn = document.createElement('button');
          btn.textContent = 'Удалить';
          btn.onclick = () => removeTask(index);
          li.appendChild(btn);
          list.appendChild(li);
        });
        countSpan.textContent = tasks.length;
      }

      function addTask() {
        const val = input.value.trim();
        if (val) {
          tasks.push(val);
          input.value = '';
          render();
        }
      }

      function removeTask(index) {
        tasks.splice(index, 1);
        render();
      }

      input.addEventListener('keydown', e => {
        if (e.key === 'Enter') addTask();
      });

      render();
    </script>
  </body>
</html>
