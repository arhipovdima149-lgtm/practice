Задание 1
<h1 id="title">Старый заголовок</h1>
<p id="description">Старое описание</p>
<button id="change">Изменить текст</button>
<script src="script.js"></script>

const title = document.getElementById('title');
const description = document.getElementById('description');
const button = document.getElementById('change');

button.addEventListener('click', () => {
  title.textContent = 'Добро пожаловать!';
  description.textContent = 'Мы изучаем JavaScript и DOM';
});



Задание 2
html

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>Изменение оформления через DOM</title>
  </head>
  <body>
    <h1 id="heading">Заголовок страницы</h1>
    <button id="color">Изменить цвет текста</button>
    <button id="background">Изменить фон страницы</button>
    <script src="script.js"></script>
  </body>
</html>

javascript

let heading = document.querySelector("#heading");

document.querySelector("#color").addEventListener("click", function() {
  heading.style.color = "red";
});

document.querySelector("#background").addEventListener("click", function() {
  document.body.style.backgroundColor = "pink";
});


